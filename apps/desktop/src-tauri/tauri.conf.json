{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visual Library",
  "version": "0.1.0",
  "identifier": "com.visuallibrary.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @visual-library/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @visual-library/ui build",
    "frontendDist": "../../../packages/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Visual Library",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
