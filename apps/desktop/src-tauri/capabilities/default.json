{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for Visual Library shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "allow-health",
    "allow-get-app-paths",
    "allow-get-settings",
    "allow-set-media-root",
    "allow-validate-media-root-cmd",
    "allow-list-themes-cmd",
    "allow-ensure-theme-cmd",
    "allow-list-concepts-cmd",
    "allow-ensure-concept-cmd",
    "allow-list-representations-cmd",
    "allow-ensure-representation-cmd",
    "allow-generate-stub-asset-cmd",
    "allow-list-waiting-review-cmd",
    "allow-list-library-assets-cmd",
    "allow-approve-asset-cmd",
    "allow-reject-asset-cmd",
    "allow-preview-manual-batch-cmd",
    "allow-submit-manual-batch-cmd",
    "allow-create-plan-cmd",
    "allow-list-plans-cmd",
    "allow-get-plan-cmd",
    "allow-add-plan-item-cmd",
    "allow-approve-plan-cmd",
    "allow-run-automatic-plan-cmd",
    "allow-edit-asset-metadata-cmd",
    "allow-mark-duplicate-cmd",
    "allow-regenerate-asset-cmd",
    "allow-get-coverage-report-cmd"
  ]
}
